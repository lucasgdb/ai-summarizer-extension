# ai-summarizer-api (../ai-summarizer-api). Its origin becomes the extension's
# only host permission, so changing it needs a rebuild + reload.
WXT_API_URL=http://localhost:8080

# lb-auth-api (../lb-auth-api): Google sign-in and sessions, shared by every
# lb-platform app. It answers this extension through CORS: its
# CORS_ALLOWED_ORIGINS must list chrome-extension://<this extension's id>.
WXT_AUTH_API_URL=http://localhost:8081

# Google Cloud → APIs & Services → Credentials → OAuth client ID, type
# "Web application", authorized redirect URI:
#   https://dndfpaedmpflakhaeiejjkmjmijfpnon.chromiumapp.org/
# Put the same client id in lb-auth-api's GOOGLE_CLIENT_IDS.
WXT_GOOGLE_CLIENT_ID=
